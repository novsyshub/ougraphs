expressions:
- name: pitch deviation (curve)
  abbr: pitd
  type: Curve
  min: -1200
  max: 1200
  default_value: 0
  is_flag: false
  flag: ""
  skip_output_if_default: false
- name: pitch override (masked curve)
  abbr: pito
  type: MaskedCurve
  min: 2400
  max: 10800
  default_value: 2400
  is_flag: false
  flag: ""
  skip_output_if_default: false
- name: gender
  abbr: gen
  type: Numerical
  min: -100
  max: 100
  default_value: 0
  is_flag: true
  flag: g
  skip_output_if_default: false
- name: Nasality
  abbr: nsl
  type: Numerical
  min: -25
  max: 25
  default_value: 0
  is_flag: false
  flag: ""
  skip_output_if_default: true
- name: Tension
  abbr: tens
  type: Numerical
  min: -100
  max: 100
  default_value: 0
  is_flag: true
  flag: Mt
  skip_output_if_default: false
- name: Openness
  abbr: opn
  type: Numerical
  min: -100
  max: 100
  default_value: 0
  is_flag: true
  flag: Mo
  skip_output_if_default: false
- name: Resonance
  abbr: res
  type: Numerical
  min: -100
  max: 100
  default_value: 0
  is_flag: true
  flag: Mr
  skip_output_if_default: false
- name: Pitch deviation (flag)
  abbr: pit
  type: Numerical
  min: -1200
  max: 1200
  default_value: 0
  is_flag: true
  flag: t
  skip_output_if_default: false
- name: Muffle
  abbr: mufl
  type: Numerical
  min: -100
  max: 100
  default_value: 0
  is_flag: false
  flag: ""
  skip_output_if_default: false
- name: formant emphasis
  abbr: frmn
  type: Numerical
  min: -100
  max: 100
  default_value: 0
  is_flag: true
  flag: ME
  skip_output_if_default: false
